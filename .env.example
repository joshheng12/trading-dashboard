# Copy to .env.local and fill in your own key(s).
# Finnhub market-data API key — https://finnhub.io/dashboard

# Server-side key used by the BFF (server/) for symbol search + quotes.
# Never exposed to the browser. Preferred going forward.
FINNHUB_API_KEY=

# Client-exposed key — used ONLY by the live WebSocket (src/services/marketStream.ts),
# which stays frontend-direct for now (ADR-015). Note: the WS URL still carries this
# key, so it remains exposed until streaming moves server-side (revisit at deploy).
VITE_FINNHUB_API_KEY=

# Alpaca credentials — used server-side by the BFF (server/alpaca.ts). Never
# exposed to the browser. The SAME paper-account key/secret cover both Alpaca APIs:
#   - Market Data (data.alpaca.markets): chart candles, free IEX feed.
#   - Trading (paper-api.alpaca.markets): account + positions (read-only for now).
# https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Official hosts only. Live trading and custom credential destinations are rejected.
# ALPACA_DATA_URL=https://data.alpaca.markets
# ALPACA_TRADING_URL=https://paper-api.alpaca.markets

# Auth for the order write endpoints (server/auth.ts, ADR-024). Reads stay public;
# only placing and cancelling orders require a session. Both must also be set in
# Netlify's env vars, or sign-in fails in production.
#   APP_PASSCODE   — the single owner passcode entered in the sign-in dialog.
#   SESSION_SECRET — signs the session cookie; any long random string, e.g.
#                    `openssl rand -base64 32`. Changing it signs out every session.
APP_PASSCODE=
SESSION_SECRET=

# AI research defaults. The local agent always starts PAUSED in RESEARCH_ONLY.
TRADING_MODE=paper
AI_TRADING_ENABLED=false
AUTO_PAPER_TRADING=false
AI_OPERATING_MODE=RESEARCH_ONLY
# Server-side only. Choose an available model that supports Responses structured output.
OPENAI_API_KEY=
OPENAI_RESEARCH_MODEL=
# Keep the local SQLite directory private and backed up. Never share one DB between accounts.
AGENT_DB_PATH=data/agent.sqlite
STOCK_UNIVERSE=AAPL,MSFT,NVDA,AMD,AMZN,GOOGL,META,TSLA,JPM,V,SPY,QQQ
MAX_RESEARCH_CANDIDATES=5
MINIMUM_STOCK_PRICE=10
# IEX feed volume, not consolidated market volume.
MINIMUM_AVERAGE_VOLUME=100000
SCAN_INTERVAL_MS=900000
MAX_PRICE_AGE_MS=120000
MAX_DAILY_BAR_AGE_MS=432000000
NEWS_MAX_AGE_MS=259200000
SCHEDULER_TICK_MS=30000
PREMARKET_MINUTES=60
ORDER_MAX_AGE_MS=900000

# Strategy weights are normalized in code. These are development settings, not optimized returns.
WEIGHT_TECHNICAL=0.35
WEIGHT_FUNDAMENTAL=0.20
WEIGHT_NEWS=0.20
WEIGHT_MARKET=0.15
WEIGHT_QUALITY=0.10
BUY_THRESHOLD=80
SELL_THRESHOLD=30
MINIMUM_CONFIDENCE=75
MINIMUM_DATA_QUALITY=80
MINIMUM_TECHNICAL_SCORE=70
MINIMUM_RELATIVE_VOLUME=1
RSI_MINIMUM=45
RSI_MAXIMUM=70
HIGH_VOLATILITY=0.025
MAX_PRICE_DRIFT=0.01

# Fractions: 0.02 = 2%. Buying uses whole-share DAY limits within this budget.
POSITION_SIZING=fixed-dollar
FIXED_POSITION_DOLLARS=250
POSITION_PORTFOLIO_FRACTION=0.01
MAX_POSITION_FRACTION=0.02
MAX_POSITIONS=5
MAX_EXPOSURE_FRACTION=0.20
MINIMUM_CASH_FRACTION=0.50
MAX_DAILY_LOSS_FRACTION=0.02
MAX_TRADES_PER_DAY=3
LOSS_COOLDOWN_MS=86400000
LIMIT_PRICE_BUFFER=0.005
